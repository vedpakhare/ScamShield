# ScamShield environment variables
# Copy this file to backend/.env and fill in your real API keys before running.
# NEVER commit the actual .env file — it is listed in .gitignore.

# Google Gemini API key (required — powers all text analysis)
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Safe Browsing API key (optional — URL reputation check)
# Enable "Safe Browsing API" in Google Cloud Console, then generate a key.
SAFE_BROWSING_KEY=your_safe_browsing_api_key_here

# VirusTotal API key (optional — URL reputation check)
# Register for free at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_KEY=your_virustotal_api_key_here
